{
	"name": "rpiv",
	"version": "1.0.0",
	"description": "",
	"license": "ISC",
	"author": "",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"lint": "biome lint skills evals .claude/hooks opencode tests scripts",
		"format": "biome format --write skills evals .claude/hooks opencode tests scripts",
		"format:check": "biome format skills evals .claude/hooks opencode tests scripts",
		"deps": "depcruise skills evals opencode",
		"knip": "knip",
		"generate:opencode": "node opencode/generate.mjs",
		"test:opencode": "vitest run tests/opencode-adapter.test.mjs tests/opencode-plugin.test.mjs",
		"typecheck:opencode": "tsc -p tsconfig.opencode.json",
		"test:vitest": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"mutate": "stryker run",
		"mutate:plan": "stryker run --incremental",
		"test": "echo \"tests run as: node <file>.test.mjs — vitest conversion is Action Item #6 (scaffold ready: npm run test:vitest)\" && exit 1"
	},
	"devDependencies": {
		"@opencode-ai/plugin": "1.14.41",
		"@biomejs/biome": "^2.5.4",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"dependency-cruiser": "^18.1.0",
		"knip": "^6.27.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
